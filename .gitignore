# --- Secrets & runtime state (NEVER commit) ---
config.yaml
config.local.yaml
session/
!session/.gitkeep
docs/
!docs/.gitkeep

# --- Run artifacts ARE committed on purpose ---
# logs/, logs/screenshots/ and logs/dom/ are deliberately NOT ignored: the Egypt
# machine pushes them with push_logs.bat so the run can be reviewed elsewhere.
#
# WARNING: screenshots and DOM dumps capture whatever was on screen, which
# includes applicant details (name, passport number, date of birth) once the
# booking form is reached. Keep this repository PRIVATE.
# Scanned documents themselves stay ignored via docs/ above.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tooling / editors ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Playwright ---
playwright-report/
test-results/
*.har

# NOTE: logs/captcha_samples/readings.jsonl is deliberately NOT ignored. It is
# written on the machine that runs the bot and must travel back with
# push_logs.bat to be graded against ground_truth.json.

# Block cooldown marker, written when the portal 403s. Machine-local.
logs/cooldown.json
