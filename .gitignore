# --- Secrets & runtime state (NEVER commit) ---
config.yaml
config.local.yaml
session/
!session/.gitkeep

# Applicant documents: passport scan and photo. These MUST stay out of git —
# they were committed once (893472a) when this line was removed, so do not
# delete it again. Scans and photos are identity documents, not build inputs.
docs/
!docs/.gitkeep

# --- Run artifacts ARE committed on purpose ---
# logs/, logs/screenshots/ and logs/dom/ are deliberately NOT ignored: the Egypt
# machine pushes them with push_logs.bat so the run can be reviewed elsewhere.
#
# WARNING: screenshots and DOM dumps capture whatever was on screen, which
# includes applicant details (name, passport number, date of birth) once the
# booking form is reached. Keep this repository PRIVATE.
# Scanned documents themselves stay ignored via docs/ above.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tooling / editors ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Playwright ---
playwright-report/
test-results/
*.har

# Captcha grid images are no longer produced (logging.save_captcha_samples is
# off — the solver is reliable, and these were 110 MB of the 301 MB the logs
# had grown to). The grading workflow they fed lives in tools/grade_captcha.py
# and still works if the switch is turned back on.
logs/captcha_samples/*.png
# ...except a REJECTED grid. Those are saved on purpose whenever the portal
# refuses an answer, and they are the only way to see what the model was
# actually shown. One was produced in run 20261014_160348 and then ignored
# straight out of the push, which is exactly when it was needed.
!logs/captcha_samples/*_REJECTED_*.png

# Block cooldown marker, written when the portal 403s. Machine-local.
logs/cooldown.json
